# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# DATAFORGE API STUDIO - DATABASE CONFIGURATION (SHARED HOSTING & CLOUD FRIENDLY)
# ==============================================================================
# Di shared hosting (cPanel, DirectAdmin, Plesk, Hostinger, Niagahoster):
# Biasanya DB_HOST cukup diisi "localhost" atau "127.0.0.1" dan DB_SSL diset "false".
# Nama database & username cPanel biasanya memiliki prefix akun Anda, misal: u1234567_dataforge

DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="dataforge_db"
DB_SSL="false"

# Alternatif format variabel lingkungan hosting lainnya (didukung otomatis):
# MYSQL_HOST="localhost"
# MYSQL_PORT="3306"
# MYSQL_USER="root"
# MYSQL_PASSWORD=""
# MYSQL_DATABASE="dataforge_db"
# MYSQL_SSL="false"
# DATABASE_URL="mysql://root:@localhost:3306/dataforge_db"

# ==============================================================================
# AUTHENTICATION & SECURITY (JWT)
# ==============================================================================
JWT_SECRET="dataforge_jwt_secret_key_change_in_production_2026_xyz"
JWT_EXPIRES_IN="7d"

# ==============================================================================
# SERVER SEND MAIL - GMAIL SMTP CONFIGURATION
# ==============================================================================
# Untuk verifikasi email pengguna baru.
# Buat App Password 16 karakter di https://myaccount.google.com/apppasswords
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
SMTP_FROM_NAME="DataForge API Studio"

